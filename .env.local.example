# Copy to `.env` for Docker Compose, or to `.env.local` for `npm run dev`.
# These are throwaway local-development values. Never reuse them anywhere real.

# --- MongoDB (Docker Compose) ---
# Root account, used only to initialise the container.
MONGO_NAME="root"
MONGO_PASS="example"
MONGO_DB="mydatabase"
# Scoped readWrite user the app connects as (created by mongo-init.js on first boot).
MONGO_APP_USERNAME="app_user"
MONGO_APP_PASSWORD="example"

# --- RabbitMQ (Docker Compose) ---
RABBITMQ_USER="user"
RABBITMQ_PASS="example"

# --- App ---
LOG_LEVEL="info"

# --- Sessions and security ---
# Session cookies get the Secure attribute only when this is "true". Use "false" for
# plain http://localhost; set "true" as soon as the app is served over HTTPS.
COOKIE_SECURE="false"
# Public origin(s) of the app, comma separated (e.g. https://crm.example.com). Requests
# that change data must come from one of these. Leave empty to accept the request's own host.
APP_ORIGIN=""
# "true" only when the app sits behind exactly one reverse proxy you control. Otherwise the
# client IP used for rate limiting comes from the socket and X-Forwarded-For is ignored.
TRUST_PROXY="false"

# --- File attachments ---
# Largest accepted upload in bytes (default 10 MB) and the most files one customer can have.
MAX_UPLOAD_BYTES="10485760"
MAX_FILES_PER_CLIENT="20"

# --- Only for running `npm run dev` on your host against the Compose containers ---
# Compose overrides both of these inside the app container, so they are ignored there.
MONGODB_URI="mongodb://app_user:example@localhost:27017/mydatabase?authSource=mydatabase"
RABBITMQ_URI="amqp://user:example@localhost:5672"
